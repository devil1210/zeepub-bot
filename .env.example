# Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OPDS Configuration
BASE_URL=https://your-opds-server.com
OPDS_ROOT_START=/opds/start
OPDS_ROOT_EVIL=/opds/evil

# Security
SECRET_SEED=your_secret_seed_here

# Admin Configuration (comma-separated user IDs)
ADMIN_USERS=123456789,987654321

# Rate Limiting
RATE_LIMIT_DOWNLOADS=10
RATE_LIMIT_COMMANDS=30
RATE_LIMIT_SEARCHES=20
MAX_DOWNLOADS_PER_HOUR=5

# Performance Settings
MAX_IN_MEMORY_BYTES=10485760
AIOHTTP_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=20

# Logging
LOG_LEVEL=INFO

# Plugin System
PLUGIN_DIRECTORY=plugins
ENABLE_PLUGINS=true

# Download Whitelist (comma-separated user IDs with unlimited downloads)
DOWNLOAD_WHITELIST=
