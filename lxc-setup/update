#!/bin/bash
set -e

echo "=== Actualizando Zeepub Bot ==="
cd /opt/zeepub-bot

# Verificar si es un repositorio git
if [ ! -d ".git" ]; then
    echo "Error: No se detectó un repositorio git."
    echo "Intentando ejecutar configuración inicial..."
    /usr/local/bin/setup-lxc.sh
    exit 0
fi

echo "1. Descargando cambios (git pull)..."
git pull origin stable

echo "2. Actualizando dependencias..."
./venv/bin/pip install -r requirements.txt

echo "3. Reiniciando servicios..."
systemctl restart zeepub-bot

echo "=== Actualización completada ==="
