# Ignorar todo por defecto
*

# Exceptuar este archivo .gitignore
!.gitignore
!Dockerfile
!docker-compose.yml
!docker-compose.prod-lib.yml
!.github/
!.github/workflows/
!.github/workflows/*.yml
!publish.sh
!start.sh
!.flake8

!scripts/
!scripts/*.sh
!scripts/*.py

# Virtualenvs
venv/
.env

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Logs
*.log

# Backups y temporales
*.bak
*.tmp

# IDEs
.vscode/
.idea/

# Excepciones: incluir solo los ficheros y directorios de código fuente
!main.py
!README.md
!DOCKER_README.md
!CHANGELOG.md
!VERSIONING.md

!bot/
!bot/*.py

