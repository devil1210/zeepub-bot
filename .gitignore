# Ignorar todo por defecto
*

# Exceptuar este archivo .gitignore
!.gitignore
!Dockerfile
!docker-compose.yml
!docker-compose.prod-lib.yml
!.github/
!.github/workflows/
!.github/workflows/*.yml
!publish.sh
!start.sh
!.flake8

!scripts/
!scripts/*.sh

# Virtualenvs
venv/
.env

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Logs
*.log

# Backups y temporales
*.bak
*.tmp

# IDEs
.vscode/
.idea/

# Excepciones: incluir solo los ficheros y directorios de código fuente
!main.py
!README.md
!DOCKER_README.md
!CHANGELOG.md
!VERSIONING.md

!bot/
!bot/*.py

!config/
!config/*.py

!core/
!core/*.py

!handlers/
!handlers/*.py

!plugins/
!plugins/*.py

!services/
!services/*.py

!opds/
!opds/*.py

!tests/
!tests/*.py

!utils/
!utils/*.py

!api/
!api/*.py

!run_with_api.py

!zeepub-web/
!zeepub-web/**

!requirements.txt
!requirements-dev.txt
!alembic.ini
!alembic/
!alembic/**

!repositories/
!repositories/*.py

!models/
!models/*.py

!v0/
!v0/**

!zeepub-miniapp/
!zeepub-miniapp/**

!bolt/
!bolt/**!debug_redundancy.py
!debug_redundancy.py
